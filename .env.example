# Opcional: desativa Hot Module Replacement (útil em sandboxes sem file watcher).
# DISABLE_HMR=true

# URL do checkout em produção (ex.: link Hotmart). Usada no CTA "GARANTIR MEU ACESSO".
# Em desenvolvimento pode ficar em branco (botão aponta para "#").
# VITE_CHECKOUT_URL=https://...

# Opcional: e-mail para contato / LGPD (exibido na Política de privacidade).
# VITE_SITE_CONTACT_EMAIL=contato@seudominio.com.br
